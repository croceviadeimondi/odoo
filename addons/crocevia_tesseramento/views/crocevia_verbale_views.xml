<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crocevia_verbale_list" model="ir.ui.view">
        <field name="name">crocevia.verbale.list</field>
        <field name="model">crocevia.verbale</field>
        <field name="arch" type="xml">
            <list>
                <field name="data"/>
                <field name="tipo"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_crocevia_verbale_form" model="ir.ui.view">
        <field name="name">crocevia.verbale.form</field>
        <field name="model">crocevia.verbale</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Es. Assemblea ordinaria approvazione bilancio..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="data"/>
                            <field name="tipo"/>
                        </group>
                        <group invisible="tipo == 'resoconto_informale'">
                            <field name="documento"
                                   filename="documento_filename"/>
                            <field name="documento_filename" invisible="1"/>
                        </group>
                    </group>
                    <!-- Resoconti informali: corpo testuale direttamente
                         in scheda, niente pdf da firmare. -->
                    <group string="Contenuto del resoconto"
                           invisible="tipo != 'resoconto_informale'">
                        <field name="contenuto" nolabel="1"
                               placeholder="Cronaca dell'incontro: chi c'era, cosa si e' discusso, decisioni provvisorie..."/>
                    </group>
                    <group string="Note / sintesi">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_crocevia_verbale_search" model="ir.ui.view">
        <field name="name">crocevia.verbale.search</field>
        <field name="model">crocevia.verbale</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Assemblee soci" name="filter_assemblea"
                        domain="[('tipo', '=', 'assemblea_soci')]"/>
                <filter string="Riunioni direttivo" name="filter_direttivo"
                        domain="[('tipo', '=', 'riunione_direttivo')]"/>
                <filter string="Resoconti informali" name="filter_resoconto"
                        domain="[('tipo', '=', 'resoconto_informale')]"/>
                <separator/>
                <filter string="Solo verbali ufficiali" name="filter_verbali_ufficiali"
                        domain="[('tipo', 'in', ['assemblea_soci', 'riunione_direttivo'])]"/>
                <group expand="0" string="Raggruppa per">
                    <filter string="Tipo" name="group_tipo"
                            context="{'group_by': 'tipo'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_crocevia_verbale" model="ir.actions.act_window">
        <field name="name">Verbali</field>
        <field name="res_model">crocevia.verbale</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Archivio verbali vuoto.
            </p>
            <p>
                Carica qui i verbali firmati delle assemblee dei soci e delle
                riunioni del direttivo (PDF o documento).
            </p>
        </field>
    </record>

</odoo>
