<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Menu radice. Sequence=15 lo colloca in cima alla barra app,
         appena sopra ai menu "Comunicazioni" e "Contatti" di Odoo. -->
    <menuitem id="menu_crocevia_root"
              name="Tesseramento"
              sequence="15"/>

    <!-- Sottomenu -->
    <menuitem id="menu_crocevia_soci"
              name="Soci"
              parent="menu_crocevia_root"
              action="action_soci"
              sequence="10"/>

    <menuitem id="menu_crocevia_richieste"
              name="Richieste iscrizione"
              parent="menu_crocevia_root"
              action="action_crocevia_richiesta"
              sequence="20"/>

    <menuitem id="menu_crocevia_cariche"
              name="Cariche direttive"
              parent="menu_crocevia_root"
              action="action_crocevia_carica"
              sequence="30"/>

    <menuitem id="menu_crocevia_verbali"
              name="Verbali"
              parent="menu_crocevia_root"
              action="action_crocevia_verbale"
              sequence="40"/>

    <!-- Icone dei menu. Lo shorthand <menuitem> non accetta web_icon
         nel validator RNG di odoo 18, quindi lo impostiamo come campo
         tramite <record> di update. Le immagini stanno in
         static/description/ del modulo. -->
    <record id="menu_crocevia_root" model="ir.ui.menu">
        <field name="web_icon">crocevia_tesseramento,static/description/icon.png</field>
    </record>
    <record id="menu_crocevia_soci" model="ir.ui.menu">
        <field name="web_icon">crocevia_tesseramento,static/description/icon_soci.png</field>
    </record>
    <record id="menu_crocevia_richieste" model="ir.ui.menu">
        <field name="web_icon">crocevia_tesseramento,static/description/icon_richieste.png</field>
    </record>
    <record id="menu_crocevia_cariche" model="ir.ui.menu">
        <field name="web_icon">crocevia_tesseramento,static/description/icon_cariche.png</field>
    </record>
    <record id="menu_crocevia_verbali" model="ir.ui.menu">
        <field name="web_icon">crocevia_tesseramento,static/description/icon_verbali.png</field>
    </record>

</odoo>
