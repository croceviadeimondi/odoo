<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crocevia_carica_list" model="ir.ui.view">
        <field name="name">crocevia.carica.list</field>
        <field name="model">crocevia.carica</field>
        <field name="arch" type="xml">
            <list decoration-bf="is_attuale" decoration-muted="not is_attuale">
                <field name="ruolo"/>
                <field name="partner_id"/>
                <field name="data_nomina"/>
                <field name="data_scadenza"/>
                <field name="is_attuale"/>
            </list>
        </field>
    </record>

    <record id="view_crocevia_carica_form" model="ir.ui.view">
        <field name="name">crocevia.carica.form</field>
        <field name="model">crocevia.carica</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="ruolo"/>
                            <field name="partner_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="is_attuale" readonly="1"/>
                        </group>
                        <group>
                            <field name="data_nomina"/>
                            <field name="data_scadenza"
                                   placeholder="Lascia vuoto se il mandato è in corso"/>
                        </group>
                    </group>
                    <group string="Note (estremi delibera, ecc.)">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crocevia_carica_search" model="ir.ui.view">
        <field name="name">crocevia.carica.search</field>
        <field name="model">crocevia.carica</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="ruolo"/>
                <filter string="In carica" name="filter_attuali"
                        domain="[('is_attuale', '=', True)]"/>
                <filter string="Cessate" name="filter_cessate"
                        domain="[('is_attuale', '=', False)]"/>
                <group expand="0" string="Raggruppa per">
                    <filter string="Ruolo" name="group_ruolo"
                            context="{'group_by': 'ruolo'}"/>
                    <filter string="Socio" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_crocevia_carica" model="ir.actions.act_window">
        <field name="name">Cariche direttive</field>
        <field name="res_model">crocevia.carica</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_attuali': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nessuna carica registrata.
            </p>
            <p>
                Registra le cariche di Presidente, Vicepresidente, Segretario
                e Tesoriere con le date di mandato.
            </p>
        </field>
    </record>

</odoo>
