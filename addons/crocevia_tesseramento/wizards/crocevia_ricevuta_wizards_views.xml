<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--                       Mensilità                                -->
    <!-- ============================================================ -->

    <record id="view_crocevia_ricevuta_mensilita_wizard_form" model="ir.ui.view">
        <field name="name">crocevia.ricevuta.mensilita.wizard.form</field>
        <field name="model">crocevia.ricevuta.mensilita.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="data"/>
                            <field name="mese_riferimento"
                                   placeholder="2026-05"/>
                        </group>
                        <group>
                            <field name="importo" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="metodo"/>
                            <field name="riferimento"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Registra contributo"
                            name="action_conferma" type="object"
                            class="oe_highlight"/>
                    <button string="Annulla"
                            class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crocevia_ricevuta_mensilita_wizard" model="ir.actions.act_window">
        <field name="name">Registra contributo mensile</field>
        <field name="res_model">crocevia.ricevuta.mensilita.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ============================================================ -->
    <!--                          Obolo                                 -->
    <!-- ============================================================ -->

    <record id="view_crocevia_ricevuta_obolo_wizard_form" model="ir.ui.view">
        <field name="name">crocevia.ricevuta.obolo.wizard.form</field>
        <field name="model">crocevia.ricevuta.obolo.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="data"/>
                        </group>
                        <group>
                            <field name="importo" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="metodo"/>
                            <field name="riferimento"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Registra obolo"
                            name="action_conferma" type="object"
                            class="oe_highlight"/>
                    <button string="Annulla"
                            class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crocevia_ricevuta_obolo_wizard" model="ir.actions.act_window">
        <field name="name">Registra obolo</field>
        <field name="res_model">crocevia.ricevuta.obolo.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
