<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--                       Mensilità                                -->
    <!-- ============================================================ -->

    <record id="view_crocevia_ricevuta_mensilita_wizard_form" model="ir.ui.view">
        <field name="name">crocevia.ricevuta.mensilita.wizard.form</field>
        <field name="model">crocevia.ricevuta.mensilita.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="data"/>
                            <field name="mese_riferimento"
                                   placeholder="2026-05"/>
                        </group>
                        <group>
                            <field name="importo" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="metodo"/>
                            <field name="riferimento"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Registra contributo"
                            name="action_conferma" type="object"
                            class="oe_highlight"/>
                    <button string="Annulla"
                            class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crocevia_ricevuta_mensilita_wizard" model="ir.actions.act_window">
        <field name="name">Registra contributo mensile</field>
        <field name="res_model">crocevia.ricevuta.mensilita.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ============================================================ -->
    <!--                       Quota annuale                            -->
    <!-- ============================================================ -->

    <record id="view_crocevia_ricevuta_quota_wizard_form" model="ir.ui.view">
        <field name="name">crocevia.ricevuta.quota.wizard.form</field>
        <field name="model">crocevia.ricevuta.quota.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Il tesseramento (quota annuale) copre anche la
                        <strong>prima mensilita'</strong> del mese qui
                        indicato. Per i mesi successivi usa "Contributo
                        mensile" come ricevuta separata.
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="data"/>
                            <field name="mese_riferimento"
                                   placeholder="2026-05"/>
                        </group>
                        <group>
                            <field name="importo" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="metodo"/>
                            <field name="riferimento"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Registra tesseramento"
                            name="action_conferma" type="object"
                            class="oe_highlight"/>
                    <button string="Annulla"
                            class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crocevia_ricevuta_quota_wizard" model="ir.actions.act_window">
        <field name="name">Registra tesseramento</field>
        <field name="res_model">crocevia.ricevuta.quota.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ============================================================ -->
    <!--                       Contributo evento                        -->
    <!-- ============================================================ -->

    <record id="view_crocevia_ricevuta_evento_wizard_form" model="ir.ui.view">
        <field name="name">crocevia.ricevuta.evento.wizard.form</field>
        <field name="model">crocevia.ricevuta.evento.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="data"/>
                            <field name="descrizione_evento"
                                   placeholder="Es. Festival Crocevia 2026"/>
                        </group>
                        <group>
                            <field name="importo" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="metodo"/>
                            <field name="riferimento"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Registra contributo"
                            name="action_conferma" type="object"
                            class="oe_highlight"/>
                    <button string="Annulla"
                            class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crocevia_ricevuta_evento_wizard" model="ir.actions.act_window">
        <field name="name">Registra contributo evento</field>
        <field name="res_model">crocevia.ricevuta.evento.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
