<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Sequenza per il numero socio progressivo del libro soci.
            Formato richiesto: numerico semplice (1, 2, 3, ...).
            Per allineare il punto di partenza al libro soci cartaceo
            esistente, modifica "Numero successivo" dopo l'installazione
            dall'UI: Impostazioni → Tecnico → Sequenze.
        -->
        <record id="seq_crocevia_numero_socio" model="ir.sequence">
            <field name="name">Numero socio Crocevia</field>
            <field name="code">crocevia.numero.socio</field>
            <field name="prefix"></field>
            <field name="suffix"></field>
            <field name="padding">1</field>
            <field name="number_increment">1</field>
            <field name="number_next_actual">1</field>
            <field name="implementation">standard</field>
        </record>

        <!--
            Sequenza per il numero ricevuta non fiscale.
            Formato: RIC/YYYY/NNNN, range per anno.
        -->
        <record id="seq_crocevia_ricevuta" model="ir.sequence">
            <field name="name">Ricevuta Crocevia</field>
            <field name="code">crocevia.ricevuta</field>
            <field name="prefix">RIC/%(year)s/</field>
            <field name="suffix"></field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next_actual">1</field>
            <field name="use_date_range" eval="True"/>
            <field name="implementation">standard</field>
        </record>
    </data>
</odoo>
