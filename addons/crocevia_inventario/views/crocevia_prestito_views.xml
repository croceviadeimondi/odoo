<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crocevia_prestito_list" model="ir.ui.view">
        <field name="name">crocevia.prestito.list</field>
        <field name="model">crocevia.prestito</field>
        <field name="arch" type="xml">
            <list decoration-warning="stato == 'in_ritardo'"
                  decoration-muted="stato == 'restituito'">
                <field name="bene_id"/>
                <field name="partner_id"/>
                <field name="data_prestito"/>
                <field name="data_restituzione_prevista"/>
                <field name="data_restituzione_effettiva"/>
                <field name="stato" widget="badge"
                       decoration-success="stato == 'restituito'"
                       decoration-warning="stato == 'in_ritardo'"
                       decoration-info="stato == 'attivo'"/>
            </list>
        </field>
    </record>

    <record id="view_crocevia_prestito_form" model="ir.ui.view">
        <field name="name">crocevia.prestito.form</field>
        <field name="model">crocevia.prestito</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_restituisci" type="object"
                            string="Restituito"
                            class="oe_highlight"
                            invisible="data_restituzione_effettiva"
                            confirm="Confermi la restituzione? La data di restituzione sara' impostata a oggi."/>
                    <field name="stato" widget="statusbar"
                           statusbar_visible="attivo,in_ritardo,restituito"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="bene_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="partner_id"
                                   options="{'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="data_prestito"/>
                            <field name="data_restituzione_prevista"
                                   placeholder="Opzionale"/>
                            <field name="data_restituzione_effettiva"
                                   readonly="1"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_crocevia_prestito_search" model="ir.ui.view">
        <field name="name">crocevia.prestito.search</field>
        <field name="model">crocevia.prestito</field>
        <field name="arch" type="xml">
            <search>
                <field name="bene_id"/>
                <field name="partner_id"/>
                <filter string="In corso" name="filter_attivi"
                        domain="[('stato', '=', 'attivo')]"/>
                <filter string="In ritardo" name="filter_ritardo"
                        domain="[('stato', '=', 'in_ritardo')]"/>
                <filter string="Restituiti" name="filter_restituiti"
                        domain="[('stato', '=', 'restituito')]"/>
                <group expand="0" string="Raggruppa per">
                    <filter string="Bene" name="group_bene"
                            context="{'group_by': 'bene_id'}"/>
                    <filter string="Prestatario" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Stato" name="group_stato"
                            context="{'group_by': 'stato'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_crocevia_prestito" model="ir.actions.act_window">
        <field name="name">Prestiti</field>
        <field name="res_model">crocevia.prestito</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_attivi': 1, 'search_default_filter_ritardo': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nessun prestito registrato.
            </p>
            <p>
                Apri un prestito dalla scheda del bene cliccando "Registra
                prestito". Qui vedi lo storico completo, con filtri di
                default su "In corso" e "In ritardo".
            </p>
        </field>
    </record>

</odoo>
