<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crocevia_sede_list" model="ir.ui.view">
        <field name="name">crocevia.sede.list</field>
        <field name="model">crocevia.sede</field>
        <field name="arch" type="xml">
            <list>
                <field name="citta"/>
                <field name="via"/>
                <field name="civico"/>
                <field name="provincia"/>
                <field name="referente_id" optional="show"/>
                <field name="is_sede_legale" optional="show"/>
                <field name="bene_count" string="Beni"/>
            </list>
        </field>
    </record>

    <record id="view_crocevia_sede_form" model="ir.ui.view">
        <field name="name">crocevia.sede.form</field>
        <field name="model">crocevia.sede</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_apri_beni" type="object"
                                class="oe_stat_button" icon="fa-archive">
                            <field name="bene_count" widget="statinfo" string="Beni"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archiviata"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="citta"/>
                            <field name="referente_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="is_sede_legale"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Indirizzo">
                            <field name="via"/>
                            <field name="civico"/>
                            <field name="cap"/>
                            <field name="provincia"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crocevia_sede_search" model="ir.ui.view">
        <field name="name">crocevia.sede.search</field>
        <field name="model">crocevia.sede</field>
        <field name="arch" type="xml">
            <search>
                <field name="citta"/>
                <field name="referente_id"/>
                <filter string="Sede legale" name="filter_legale"
                        domain="[('is_sede_legale', '=', True)]"/>
                <filter string="Archiviate" name="filter_archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Raggruppa per">
                    <filter string="Citta'" name="group_citta"
                            context="{'group_by': 'citta'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_crocevia_sede" model="ir.actions.act_window">
        <field name="name">Sedi</field>
        <field name="res_model">crocevia.sede</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nessuna sede registrata.
            </p>
            <p>
                Le sedi del Crocevia raggruppano i beni nell'inventario
                e identificano l'ubicazione fisica di giochi, manuali e
                libri.
            </p>
        </field>
    </record>

</odoo>
