<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Regole dei prestiti dalla miniapp. Si cambiano da
         Impostazioni > Tecnico > Parametri di sistema. -->
    <record id="param_giorni_prestito" model="ir.config_parameter">
        <field name="key">crocevia_miniapp.giorni_prestito</field>
        <field name="value">30</field>
    </record>
    <record id="param_max_prestiti" model="ir.config_parameter">
        <field name="key">crocevia_miniapp.max_prestiti</field>
        <field name="value">1</field>
    </record>
</odoo>
