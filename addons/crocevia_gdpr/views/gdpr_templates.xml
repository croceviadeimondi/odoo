<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="pagina_accettazione" name="Accettazione informativa GDPR">
        <t t-call="web.layout">
            <div class="container" style="max-width:760px;margin:48px auto;padding:0 16px;">
                <h2 style="color:#714B67;">Informativa sulla privacy</h2>
                <p class="text-muted">
                    Per usare il gestionale del Crocevia dei Mondi APS devi
                    prendere visione e accettare l'informativa qui sotto.
                </p>
                <div class="border rounded p-3 mb-4"
                     style="max-height:50vh;overflow:auto;background:#fff;">
                    <t t-out="informativa"/>
                </div>
                <form action="/crocevia/gdpr/accetta" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                    <button type="submit" class="btn btn-primary btn-lg">
                        Ho letto e accetto
                    </button>
                    <a href="/web/session/logout" class="btn btn-link">Esci</a>
                </form>
            </div>
        </t>
    </template>

</odoo>
