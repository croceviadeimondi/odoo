<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crocevia_attivita_volontariato_list" model="ir.ui.view">
        <field name="name">crocevia.attivita.volontariato.list</field>
        <field name="model">crocevia.attivita.volontariato</field>
        <field name="arch" type="xml">
            <list>
                <field name="data"/>
                <field name="partner_id"/>
                <field name="attivita"/>
                <field name="ore" sum="Totale ore"/>
                <field name="project_id" optional="show"/>
                <field name="sede_id" optional="hide"/>
                <field name="polizza" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_crocevia_attivita_volontariato_form" model="ir.ui.view">
        <field name="name">crocevia.attivita.volontariato.form</field>
        <field name="model">crocevia.attivita.volontariato</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="data"/>
                            <field name="ore"/>
                        </group>
                        <group>
                            <field name="attivita"/>
                            <field name="project_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="sede_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="polizza"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_crocevia_attivita_volontariato_search" model="ir.ui.view">
        <field name="name">crocevia.attivita.volontariato.search</field>
        <field name="model">crocevia.attivita.volontariato</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="attivita"/>
                <field name="project_id"/>
                <field name="sede_id"/>
                <filter string="Anno corrente" name="filter_anno_corrente"
                        domain="[('data', '&gt;=', (context_today() - relativedelta(month=1, day=1)).strftime('%Y-%m-%d')), ('data', '&lt;', (context_today() + relativedelta(years=1, month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Mese corrente" name="filter_mese_corrente"
                        domain="[('data', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')), ('data', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Raggruppa per">
                    <filter string="Volontario" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="Progetto" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="Sede" name="group_sede"
                            context="{'group_by': 'sede_id'}"/>
                    <filter string="Mese" name="group_mese"
                            context="{'group_by': 'data:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_crocevia_attivita_volontariato" model="ir.actions.act_window">
        <field name="name">Ore prestate</field>
        <field name="res_model">crocevia.attivita.volontariato</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_anno_corrente': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nessuna ora di volontariato registrata.
            </p>
            <p>
                Le ore prestate dai volontari possono essere registrate da
                qui o direttamente dalla scheda del volontario (tab
                "Volontariato"). Sono utili per la rendicontazione dei
                bandi (Regione, Fondazioni, 5x1000) e per la copertura
                INAIL dei volontari non occasionali.
            </p>
        </field>
    </record>

</odoo>
