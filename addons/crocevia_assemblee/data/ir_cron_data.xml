<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron orario che chiude i sondaggi scaduti.
             noupdate=1 cosi' eventuali modifiche dell'utente
             (es. disattivazione, cambio frequenza) non vengono
             sovrascritte agli upgrade del modulo. -->
        <record id="cron_chiudi_sondaggi_scaduti" model="ir.cron">
            <field name="name">Crocevia Assemblee: chiudi sondaggi scaduti</field>
            <field name="model_id" ref="model_crocevia_sondaggio"/>
            <field name="state">code</field>
            <field name="code">model.cron_chiudi_scaduti()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
