<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action "Resoconti": stessa view list/form di crocevia.verbale
         ma filtrata su tipo=resoconto_informale, e il context pre-popola
         il tipo cosi' i nuovi record creati da qui sono gia' resoconti. -->
    <record id="action_crocevia_resoconto" model="ir.actions.act_window">
        <field name="name">Resoconti</field>
        <field name="res_model">crocevia.verbale</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('tipo', '=', 'resoconto_informale')]</field>
        <field name="context">{'default_tipo': 'resoconto_informale'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nessun resoconto informale ancora scritto.
            </p>
            <p>
                I resoconti sono note di lavoro non firmate, scritte
                direttamente in pagina (markdown), per ricordi di
                chiacchierate o incontri online. Per i verbali ufficiali
                firmati su PDF c'e' la sezione "Verbali".
            </p>
        </field>
    </record>

</odoo>
