<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron mensile reminder vidimazione. In Odoo 18 ir.cron e'
             una vista di ir.actions.server con usage=ir_cron, si crea
             come record server action con i campi cron flat (interval_*). -->
        <record id="ir_cron_reminder_vidimazione" model="ir.cron">
            <field name="name">Registro Volontari: reminder vidimazione</field>
            <field name="model_id" ref="model_crocevia_registro_vidimazione"/>
            <field name="state">code</field>
            <field name="code">model._cron_alert_vidimazione()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
