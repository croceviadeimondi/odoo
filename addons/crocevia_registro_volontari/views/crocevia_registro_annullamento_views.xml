<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_registro_annullamento_list" model="ir.ui.view">
        <field name="name">crocevia.registro.iscrizione.annullamento.list</field>
        <field name="model">crocevia.registro.iscrizione.annullamento</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="iscrizione_id"/>
                <field name="motivazione"/>
                <field name="data_annullamento"/>
                <field name="responsabile_id"/>
            </list>
        </field>
    </record>

    <record id="view_registro_annullamento_form" model="ir.ui.view">
        <field name="name">crocevia.registro.iscrizione.annullamento.form</field>
        <field name="model">crocevia.registro.iscrizione.annullamento</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="iscrizione_id" readonly="1"/>
                        <field name="data_annullamento" readonly="1"/>
                        <field name="responsabile_id" readonly="1"/>
                    </group>
                    <group string="Motivazione">
                        <field name="motivazione" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_registro_annullamento" model="ir.actions.act_window">
        <field name="name">Annullamenti</field>
        <field name="res_model">crocevia.registro.iscrizione.annullamento</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
