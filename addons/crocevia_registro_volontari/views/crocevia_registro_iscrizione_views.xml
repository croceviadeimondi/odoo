<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_registro_iscrizione_list" model="ir.ui.view">
        <field name="name">crocevia.registro.iscrizione.list</field>
        <field name="model">crocevia.registro.iscrizione</field>
        <field name="arch" type="xml">
            <list decoration-muted="stato == 'annullato'"
                  decoration-warning="stato == 'cessato'">
                <field name="numero_iscrizione" string="N."/>
                <field name="cognome"/>
                <field name="nome"/>
                <field name="codice_fiscale"/>
                <field name="tipo" widget="badge"/>
                <field name="data_inizio_attivita"/>
                <field name="data_fine_attivita" optional="show"/>
                <field name="stato" widget="badge"
                       decoration-success="stato == 'iscritto'"
                       decoration-warning="stato == 'cessato'"
                       decoration-danger="stato == 'annullato'"/>
            </list>
        </field>
    </record>

    <record id="view_registro_iscrizione_form" model="ir.ui.view">
        <field name="name">crocevia.registro.iscrizione.form</field>
        <field name="model">crocevia.registro.iscrizione</field>
        <field name="arch" type="xml">
            <form create="true" edit="true">
                <header>
                    <field name="stato" widget="statusbar"
                           statusbar_visible="iscritto,cessato,annullato"/>
                    <button name="%(action_crocevia_registro_cessazione_wizard)d"
                            type="action" string="Cessa iscrizione"
                            invisible="stato != 'iscritto'"
                            context="{'default_iscrizione_id': id}"/>
                    <button name="%(action_crocevia_registro_annullamento_wizard)d"
                            type="action" string="Annulla iscrizione"
                            groups="crocevia_registro_volontari.group_registro_responsabile"
                            invisible="stato == 'annullato'"
                            context="{'default_iscrizione_id': id}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-link"
                                disabled="1">
                            <field name="numero_iscrizione" widget="statinfo"
                                   string="N. iscrizione"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Annullato"
                            bg_color="text-bg-danger"
                            invisible="stato != 'annullato'"/>
                    <widget name="web_ribbon" title="Cessato"
                            bg_color="text-bg-warning"
                            invisible="stato != 'cessato'"/>
                    <div class="alert alert-info" role="alert"
                         invisible="numero_iscrizione">
                        Tutti i campi anagrafici sono <strong>write-once</strong>:
                        compilali con cura, dopo la creazione non potranno
                        essere modificati (DM 6 ottobre 2021).
                    </div>
                    <group>
                        <group string="Anagrafica">
                            <field name="partner_id"
                                   readonly="numero_iscrizione"
                                   options="{'no_create_edit': True}"/>
                            <field name="cognome"
                                   readonly="numero_iscrizione"/>
                            <field name="nome"
                                   readonly="numero_iscrizione"/>
                            <field name="codice_fiscale"
                                   readonly="numero_iscrizione"
                                   placeholder="RSSMRA80A01H501U"/>
                            <field name="data_nascita"
                                   readonly="numero_iscrizione"/>
                            <field name="luogo_nascita"
                                   readonly="numero_iscrizione"/>
                        </group>
                        <group string="Residenza">
                            <field name="indirizzo_residenza"
                                   readonly="numero_iscrizione"/>
                            <field name="cap_residenza"
                                   readonly="numero_iscrizione"/>
                            <field name="citta_residenza"
                                   readonly="numero_iscrizione"/>
                            <field name="provincia_residenza"
                                   readonly="numero_iscrizione"/>
                        </group>
                    </group>
                    <group>
                        <group string="Volontariato">
                            <field name="tipo"
                                   readonly="numero_iscrizione"/>
                            <field name="data_inizio_attivita"
                                   readonly="numero_iscrizione"/>
                            <field name="data_fine_attivita" readonly="1"/>
                            <field name="consenso_privacy_data"
                                   readonly="numero_iscrizione"/>
                        </group>
                        <group string="Integrita'"
                               invisible="not numero_iscrizione">
                            <field name="hash_record" readonly="1"/>
                            <field name="hash_precedente" readonly="1"/>
                        </group>
                    </group>
                    <group string="Attivita' svolta">
                        <field name="attivita_svolta" nolabel="1"
                               readonly="numero_iscrizione"/>
                    </group>
                    <group string="Annullamento"
                           invisible="not annullamento_id">
                        <field name="annullamento_id" readonly="1"/>
                        <field name="motivo_annullamento" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_registro_iscrizione_search" model="ir.ui.view">
        <field name="name">crocevia.registro.iscrizione.search</field>
        <field name="model">crocevia.registro.iscrizione</field>
        <field name="arch" type="xml">
            <search>
                <field name="cognome"/>
                <field name="codice_fiscale"/>
                <field name="numero_iscrizione"/>
                <filter string="Iscritti" name="filter_iscritti"
                        domain="[('stato', '=', 'iscritto')]"/>
                <filter string="Cessati" name="filter_cessati"
                        domain="[('stato', '=', 'cessato')]"/>
                <filter string="Annullati" name="filter_annullati"
                        domain="[('stato', '=', 'annullato')]"/>
                <separator/>
                <filter string="Abituali" name="filter_abituali"
                        domain="[('tipo', '=', 'abituale')]"/>
                <filter string="Occasionali" name="filter_occasionali"
                        domain="[('tipo', '=', 'occasionale')]"/>
                <group expand="0" string="Raggruppa per">
                    <filter string="Tipo" name="group_tipo"
                            context="{'group_by': 'tipo'}"/>
                    <filter string="Stato" name="group_stato"
                            context="{'group_by': 'stato'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_registro_iscrizione" model="ir.actions.act_window">
        <field name="name">Iscrizioni registro</field>
        <field name="res_model">crocevia.registro.iscrizione</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_iscritti': 1}</field>
    </record>

    <!-- Server action "Verifica catena di integrita'" -->
    <record id="action_server_verifica_catena" model="ir.actions.server">
        <field name="name">Verifica catena di integrita'</field>
        <field name="model_id" ref="model_crocevia_registro_iscrizione"/>
        <field name="binding_model_id" ref="model_crocevia_registro_iscrizione"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = model.action_verifica_catena()</field>
    </record>

</odoo>
