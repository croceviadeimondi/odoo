<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Gruppo "Direttivo del Crocevia": ruolo unificato che da ai
             membri del direttivo i permessi tipici di un admin Odoo
             ristretti all'ambito gestionale dell'APS. La categoria e'
             quella gia' definita da crocevia_tesseramento. -->
        <record id="group_crocevia_direttivo_master" model="res.groups">
            <field name="name">Direttivo del Crocevia</field>
            <field name="category_id"
                   ref="crocevia_tesseramento.module_category_crocevia"/>
            <field name="comment">Ruolo unificato per i membri del direttivo: ingloba i permessi di amministrazione di sistema, gestione contatti, contabilita', volontari, note spese, tesseramento e inventario. Equivale praticamente a un admin Odoo limitato all'ambito gestionale dell'APS.</field>
            <field name="implied_ids" eval="[
                (4, ref('base.group_system')),
                (4, ref('base.group_partner_manager')),
                (4, ref('account.group_account_manager')),
                (4, ref('crocevia_tesseramento.group_crocevia_direttivo')),
                (4, ref('crocevia_inventario.group_crocevia_inventario')),
            ]"/>
        </record>

    </data>
</odoo>
