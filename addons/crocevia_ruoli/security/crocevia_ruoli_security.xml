<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Scala ruoli a 4 livelli, ciascuno implica il precedente:
             Esterno (solo base.group_user, nessun gruppo qui sotto) <
             Membro del Crocevia < Amministrazione del Crocevia < Direttivo.
             Categoria condivisa: in scheda utente appaiono come selezione
             graduata del ruolo Crocevia. -->

        <!-- ESTERNO: collaboratore (anche di altre associazioni) che
             condivide solo la todolist. Vede Progetti/Todo e Calendario,
             niente dati del Crocevia. -->
        <record id="group_crocevia_esterno" model="res.groups">
            <field name="name">Collaboratore esterno (todolist)</field>
            <field name="category_id"
                   ref="crocevia_tesseramento.module_category_crocevia"/>
            <field name="comment">Accesso minimo: todolist/progetti condivisi e calendario. Nessun accesso a soci, inventario, volontari o cassa.</field>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('project.group_project_user')),
            ]"/>
        </record>

        <!-- MEMBRO: volontario/socio operativo. -->
        <record id="group_crocevia_membro" model="res.groups">
            <field name="name">Membro del Crocevia</field>
            <field name="category_id"
                   ref="crocevia_tesseramento.module_category_crocevia"/>
            <field name="comment">Volontario/socio operativo: modifica inventario e ore di volontariato, propone nuovi soci (richieste) e consulta le liste. Non valida soci ne' gestisce la cassa.</field>
            <field name="implied_ids" eval="[(4, ref('group_crocevia_esterno'))]"/>
        </record>

        <!-- AMMINISTRAZIONE: gestione operativa. Ingloba i gruppi
             gestionali per-modulo (prima agganciati al direttivo). -->
        <record id="group_crocevia_amministrazione" model="res.groups">
            <field name="name">Amministrazione del Crocevia</field>
            <field name="category_id"
                   ref="crocevia_tesseramento.module_category_crocevia"/>
            <field name="comment">Gestione operativa: valida soci, gestisce libro soci e libro volontari, cassa e contabilita', crea progetti. Ingloba i permessi gestionali di tesseramento, inventario, volontariato e contabilita'.</field>
            <field name="implied_ids" eval="[
                (4, ref('group_crocevia_membro')),
                (4, ref('base.group_partner_manager')),
                (4, ref('account.group_account_manager')),
                (4, ref('crocevia_tesseramento.group_crocevia_direttivo')),
                (4, ref('crocevia_inventario.group_crocevia_inventario')),
                (4, ref('crocevia_volontariato.group_crocevia_volontariato')),
            ]"/>
        </record>

        <!-- DIRETTIVO: amministrazione + admin di sistema (Applicazioni,
             Impostazioni). Riservato ai membri del direttivo. -->
        <record id="group_crocevia_direttivo_master" model="res.groups">
            <field name="name">Direttivo del Crocevia</field>
            <field name="category_id"
                   ref="crocevia_tesseramento.module_category_crocevia"/>
            <field name="comment">Ruolo del direttivo: tutto cio' che fa l'Amministrazione + amministrazione di sistema (Applicazioni, Impostazioni). Equivale a un admin Odoo limitato all'ambito gestionale dell'APS.</field>
            <field name="implied_ids" eval="[
                (4, ref('group_crocevia_amministrazione')),
                (4, ref('base.group_system')),
            ]"/>
        </record>

    </data>
</odoo>
