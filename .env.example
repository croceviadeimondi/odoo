# Crocevia dei Mondi — variabili d'ambiente Docker
# Copia questo file in `.env` e personalizza i valori.
# IMPORTANTE: `.env` NON va committato (è in .gitignore).

# --- Credenziali PostgreSQL ---
DB_USER=odoo
DB_PASSWORD=cambia_questa_password_del_database

# --- Porta su cui esporre Odoo sul server ---
ODOO_PORT=8069

# --- Indirizzo di bind del container Odoo ---
# In dev locale: 0.0.0.0 (default, accessibile da LAN).
# In produzione VPS: 127.0.0.1 (raggiungibile solo da nginx sullo stesso
# host, mai esposto direttamente su internet).
ODOO_BIND=0.0.0.0
