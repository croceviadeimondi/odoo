# Segreti e configurazione locale
.env
config/odoo.conf

# Dati locali / log (solo /data alla radice del repo — NON le cartelle data/
# dei moduli Odoo, che contengono XML versionati)
/data/
*.log
/logs/*
!/logs/.gitkeep

# Python / Odoo build artifacts
__pycache__/
*.py[cod]
*.egg-info/

# Editor / OS
.idea/
.vscode/
.DS_Store

# Note di sviluppo locali per Claude Code (non vanno in repo: contengono
# appunti dell'utente, valori in evoluzione, eventuali credenziali di
# servizio in chiaro durante lo sviluppo).
CLAUDE.md
CLAUDE.local.md

# DATI PERSONALI DEI SOCI - GDPR / art. 622 c.p.
# NON committare MAI il registro soci o suoi derivati. Lo script di
# trasformazione (`tools/importa_registro_soci.py`) gira sul pc del
# segretario, l'output CSV va caricato direttamente in odoo via UI e
# NON deve transitare dal repo.
#
# Pattern aggressivi case-insensitive (Git rispetta case-sensitivity
# di default; questi pattern includono varianti con maiuscole iniziali).
registro_soci*
Registro_soci*
registro*.csv
Registro*.csv
*tesserati*
*Tesserati*
soci_export*
soci_import*
soci_per_odoo*
*soci*.csv
*Soci*.csv
*_dati_personali*

# Tutti i csv dentro tools/ sono file di dati di lavoro, non codice.
# Lo script `tools/importa_registro_soci.py` produce csv di output
# qui o l'utente mette qui gli input per comodita': mai versionarli.
tools/*.csv

# Formati di foglio elettronico (registro originale di solito qui)
*.xlsx
*.xls
*.ods
*.numbers
